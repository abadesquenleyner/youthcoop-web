{
  "name": "youthcoop-static",
  "private": true,
  "version": "1.0.0",
  "description": "Copia estática del sitio público de YOUTH COOP (React + Vite + TypeScript) para GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "media": "node scripts/build-media.mjs",
    "textos": "node scripts/build-textos.mjs",
    "panel": "node scripts/generar-panel-textos.mjs",
    "predev": "node scripts/build-media.mjs && node scripts/build-textos.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-media.mjs && node scripts/build-textos.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
